# Pages headers. Repo/config files are never part of the site, but if a stale
# edge object for one of these paths is ever hit, do not cache or index it.
/wrangler.toml
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/deploy.sh
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/README.md
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/tools/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Studio and auth pages must always reflect the latest deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/login
  Cache-Control: public, max-age=0, must-revalidate

/create-account
  Cache-Control: public, max-age=0, must-revalidate

/account
  Cache-Control: public, max-age=0, must-revalidate

/receive
  Cache-Control: public, max-age=0, must-revalidate

/why
  Cache-Control: public, max-age=0, must-revalidate

/support
  Cache-Control: public, max-age=0, must-revalidate

/images
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

